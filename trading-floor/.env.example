# Copy to .env and fill locally. Commit this file only. Values stay empty.
# TRADING_MODE is read by execution. Unset or "paper" is PAPER. "live" waits
# for the TTY phrase. Any other value refuses startup. The phrase is not an env var.

# --- execution (live CEX keys only after TTY confirmation; paper may use Alpaca paper) ---
TRADING_MODE=
COINBASE_API_KEY_NAME=
COINBASE_API_PRIVATE_KEY=
KRAKEN_API_KEY=
KRAKEN_API_SECRET=
ALPACA_API_KEY=
ALPACA_API_SECRET=
ALPACA_PAPER_API_KEY=
ALPACA_PAPER_API_SECRET=

# --- data and read-only MCP sidecars (not the agent process) ---
COINBASE_MARKET_DATA_KEY=
KRAKEN_MARKET_DATA_KEY=
ALPACA_DATA_API_KEY=
ALPACA_DATA_API_SECRET=
HELIUS_RPC_URL=
QUICKNODE_RPC_URL=
SOLANA_DEVNET_RPC_URL=

# --- moonit_connector only. Never Python. ---
SOLANA_HOT_WALLET_PRIVATE_KEY=
JUPITER_API_KEY=

# --- risk, execution, moonit_connector (verify / mint). Execution verifies; it does not mint. ---
RISK_TOKEN_KEY=

# --- compliance, execution, moonit_connector ---
COMPLIANCE_TOKEN_KEY=

# --- agents (not started in Phase 0) ---
ANTHROPIC_API_KEY=

# --- comms ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# --- console_api. Command token stays with Christopher. ---
CONSOLE_READ_TOKEN=
CONSOLE_COMMAND_TOKEN=

# --- infra. No defaults are baked into Compose. ---
DATABASE_URL=
REDIS_URL=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
